{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "troop-finances",
  "main": "src/index.tsx",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare creates these two resources for you on first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "troop-finances", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "RECEIPTS", "bucket_name": "troop-finances-receipts" }],
  "triggers": { "crons": ["17 8 * * *"] },
  "vars": {
    "TROOP_NAME": "Our Troop",
    "ADMIN_EMAILS": "mike@landers.dev",
    "EMAIL_FROM": "mike@landers.dev"
  },
  // Lets the Worker import its schema file as text, so it can create its own tables on first run.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true }
}
