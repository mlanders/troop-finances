# Settings for docker-compose.prod.yml (a server of your own; infra/SETUP.md "Your own server").
# Copy to .env.prod on the server and fill it in. .env.prod holds secrets: never commit it.

# ---- The site ----
# A DNS A record for this name must point at this server.
SITE_DOMAIN=finance.troop52.org
TROOP_NAME=Troop 52
TROOP_CONTACT_EMAIL=treasurer@troop52.org
TROOP_TIME_ZONE=America/Chicago

# ---- Who runs it ----
GLOBAL_ADMIN_EMAIL=you@example.org
EDITOR_EMAIL=treasurer@troop52.org
# openssl rand -base64 48   -- keep it forever: changing it unlinks every guardian's authenticator app
LOGIN_CODE_PEPPER=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Admin sign-in: Google and/or Microsoft (infra/SETUP.md step 1) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Email (infra/SETUP.md step 2) ----
EMAIL_SENDER_ADDRESS=noreply@troop52.org
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=

# ---- Backups somewhere other than this server (recommended): an S3-compatible bucket ----
# BACKUP_PROVIDER=S3
# BACKUP_S3_BUCKET=troop52-backups
# BACKUP_S3_SERVICE_URL=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# ---- Optional: a different image, e.g. a fixed version ----
# APP_IMAGE=ghcr.io/sacparker09/troop-finances:v1.0.0
