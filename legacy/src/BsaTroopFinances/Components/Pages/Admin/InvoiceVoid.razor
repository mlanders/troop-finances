@page "/admin/invoices/{Id}/void"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminWriter")]
@inject IInvoiceRepository InvoiceRepository
@inject IScoutAccountService ScoutAccountService
@inject NavigationManager Navigation
@using BsaTroopFinances.Data.Entities
@using BsaTroopFinances.Data.Repositories
@using BsaTroopFinances.Services

<PageTitle>Void Invoice</PageTitle>

<div class="page-header-row">
    <h1>Void Invoice</h1>
    <a class="back-link" href="@InvoiceUrl"><span aria-hidden="true" style="margin-right:0.35rem;">&larr;</span>Back to invoice</a>
</div>

@if (_loading)
{
    <p>Loading&hellip;</p>
}
else if (_invoice is null)
{
    <div class="alert alert-danger">Invoice not found.</div>
}
else if (_invoice.StatusValue != InvoiceStatus.Outstanding)
{
    <div class="alert alert-warning">This invoice is @_invoice.StatusValue.ToLowerInvariant(), so it can't be voided.</div>
}
else
{
    <div class="card">
        <h2>@_invoice.BilledTo — @_invoice.Description</h2>
        <p><strong>Total:</strong> @_invoice.TotalAmount.ToString("C")</p>
        <p><strong>Remaining due:</strong> <span class="money">@_invoice.AmountDueFromFamily.ToString("C")</span></p>
        @if (_invoice.AmountAppliedFromAccount > 0)
        {
            <p><strong>Applied from account:</strong> @_invoice.AmountAppliedFromAccount.ToString("C")
                <span class="hint">&mdash; credited back to @_invoice.ScoutName's account when voided</span></p>
        }

        <p class="hint">Voiding cancels the invoice. It stays in the history marked Voided, and this can't be undone.</p>

        <div class="field">
            <label for="voidReason">Reason</label>
            <input id="voidReason" type="text" @bind="_voidReason" @bind:event="oninput" />
        </div>
        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }
        @if (_confirming)
        {
            <div class="alert alert-danger">
                <strong>Void this invoice for @_invoice.BilledTo (@_invoice.Description)?</strong> This can't be undone.
            </div>
            <div class="row-actions">
                <button class="btn btn-danger" disabled="@_saving" @onclick="ConfirmVoid">Confirm void</button>
                <button class="btn btn-outline-danger" disabled="@_saving" @onclick="() => _confirming = false">Cancel</button>
            </div>
        }
        else
        {
            <div class="row-actions">
                <button class="btn btn-danger" disabled="@string.IsNullOrWhiteSpace(_voidReason)" @onclick="() => _confirming = true">Void invoice</button>
                <a class="btn btn-secondary" href="@InvoiceUrl">Cancel</a>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    private string? ScoutId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _confirming;
    private string? _error;
    private string _voidReason = string.Empty;
    private InvoiceEntity? _invoice;

    private string InvoiceUrl => string.IsNullOrEmpty(ScoutId)
        ? $"/admin/invoices/{Id}"
        : $"/admin/invoices/{Id}?scoutId={Uri.EscapeDataString(ScoutId)}";

    protected override async Task OnInitializedAsync()
    {
        _invoice = string.IsNullOrEmpty(ScoutId) ? null : await InvoiceRepository.GetByIdAsync(ScoutId, Id);
        _invoice ??= await InvoiceRepository.GetByInvoiceIdAsync(Id);
        _loading = false;
    }

    private async Task ConfirmVoid()
    {
        if (_invoice is null || string.IsNullOrWhiteSpace(_voidReason) || _saving)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var authState = AuthStateTask is not null ? await AuthStateTask : null;
            var user = authState?.User.Identity?.Name ?? "unknown";
            await ScoutAccountService.VoidInvoiceAsync(_invoice.OwnerId, _invoice.InvoiceId, _voidReason.Trim(), user);
            Navigation.NavigateTo(InvoiceUrl);
        }
        catch (Exception)
        {
            _error = "Couldn't void this invoice. Please try again.";
            _confirming = false;
        }
        finally
        {
            _saving = false;
        }
    }
}
