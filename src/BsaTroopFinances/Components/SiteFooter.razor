@* The footer of the signed-in areas (AdminLayout, PortalLayout): the legal pages, and which build
   of the app this is (Services/AppVersion.cs). The public pages have their own, without the
   version (PublicLayout). *@

<footer class="site-footer">
    <a href="/privacy">Privacy Policy</a>
    <span aria-hidden="true">&middot;</span>
    <a href="/terms">Terms of Service</a>
    <span aria-hidden="true">&middot;</span>
    <span class="site-footer-version" title="@Version.Commit">@Version.Display</span>
</footer>

@code {
    private static AppVersion Version => AppVersion.Current;
}
