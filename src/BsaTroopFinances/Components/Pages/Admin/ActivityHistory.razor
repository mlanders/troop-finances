@page "/admin/settings/activity"
@rendermode InteractiveServer
@inject IFinanceAuditRepository AuditRepository
@inject TimeProvider TimeProvider
@using BsaTroopFinances.Data.Entities
@using BsaTroopFinances.Data.Repositories

<PageTitle>Activity History</PageTitle>

<div class="page-header-row">
    <h1>Activity History</h1>
</div>

@if (_loading)
{
    <p>Loading&hellip;</p>
}
else
{
    <div class="action-bar">
        <div class="filter-group" role="group" aria-label="Activity type filter">
            <span class="filter-label">Type</span>
            <div class="choice-grid-compact">
                <button class="choice-btn choice-btn-compact @(_activityTypeFilter is null ? "selected" : "")" @onclick="() => SetActivityTypeFilter(null)">All</button>
                @foreach (var type in ActivityTypes)
                {
                    <button class="choice-btn choice-btn-compact @(_activityTypeFilter == type ? "selected" : "")" @onclick="() => SetActivityTypeFilter(type)">@type</button>
                }
            </div>
        </div>
        <span class="hint" style="margin-left:auto;">Note: will only show last three months</span>
    </div>

    <div class="card">
        @if (FilteredActivityCount == 0)
        {
            <p>No activity here.</p>
        }
        else
        {
            <ul class="timeline">
                @foreach (var entry in PagedActivity)
                {
                    var (icon, colorClass) = FinanceAuditEntityType.IconFor(entry.EntityType);
                    <li class="timeline-item">
                        <span class="timeline-dot @colorClass"><i class="fa-solid @icon" aria-hidden="true"></i></span>
                        <span class="hint timeline-when">@entry.OccurredUtc.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                        <span>
                            <strong><a href="@FinanceAuditEntityType.DetailUrl(entry.EntityType, entry.EntityId)">@entry.EntityType</a></strong>
                            &mdash; @entry.Action
                            @if (!string.IsNullOrEmpty(entry.Actor))
                            {
                                <span class="hint"> by @entry.Actor</span>
                            }
                            @if (!string.IsNullOrEmpty(entry.Details) || !string.IsNullOrEmpty(entry.Notes))
                            {
                                <br /><span class="hint">@entry.Details @entry.Notes</span>
                            }
                        </span>
                    </li>
                }
            </ul>

            <div class="row-actions" style="margin-top:0.75rem;">
                <button class="btn btn-secondary" disabled="@(_activityPage <= 1)" @onclick="() => _activityPage--">Previous</button>
                <span class="hint">Page @_activityPage of @ActivityTotalPages (@FilteredActivityCount action@(FilteredActivityCount == 1 ? "" : "s"))</span>
                <button class="btn btn-secondary" disabled="@(_activityPage >= ActivityTotalPages)" @onclick="() => _activityPage++">Next</button>
            </div>
        }
    </div>
}

@code {
    private const int PageSize = 25;

    private static readonly string[] ActivityTypes =
        [FinanceAuditEntityType.Reimbursement, FinanceAuditEntityType.Invoice, FinanceAuditEntityType.Fundraiser];

    private bool _loading = true;
    private IReadOnlyList<FinanceAuditEntryEntity> _activity = [];
    private string? _activityTypeFilter;
    private int _activityPage = 1;

    private IEnumerable<FinanceAuditEntryEntity> FilteredActivity => _activity
        .Where(e => _activityTypeFilter is null || e.EntityType == _activityTypeFilter);

    private int FilteredActivityCount => FilteredActivity.Count();

    private int ActivityTotalPages => Math.Max(1, (int)Math.Ceiling(FilteredActivityCount / (double)PageSize));

    private IEnumerable<FinanceAuditEntryEntity> PagedActivity => FilteredActivity.Skip((_activityPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        _activity = await AuditRepository.GetSinceAsync(TimeProvider.GetUtcNow().AddMonths(-3));
        _loading = false;
    }

    private void SetActivityTypeFilter(string? type)
    {
        _activityTypeFilter = type;
        _activityPage = 1;
    }
}
