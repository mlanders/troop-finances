@inject TroopInfo Troop
@* The unauthenticated shell: the landing page and the parent login form. Minimal chrome, no
   nav -- visitors haven't chosen (or completed) a login path yet. *@
@inherits LayoutComponentBase

<header class="public-header">
    <span class="public-brand">@Troop.AppName</span>
</header>

<div class="public-shell">
    @Body
</div>

<footer class="public-footer">
    <a href="/privacy">Privacy Policy</a>
    <span aria-hidden="true">&middot;</span>
    <a href="/terms">Terms of Service</a>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
